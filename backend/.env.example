# Copy to .env and fill in to enable real external services.
# When MOCK_EXTERNAL=true (default) the app runs fully offline with local mocks.

# Set to false + provide a key to use the real DeepSeek API for classification,
# variant generation, grading and chat.
MOCK_EXTERNAL=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Frontend dev server origins allowed by CORS.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
